		"main": [
			"com.gst.GalacticSpaceTravel"
		],
		"client": [
			"com.gst.client.GalacticSpaceTravelClient"
		]
	},
	"mixins": [
		"gst.mixins.json",
		{
			"config": "gst.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"

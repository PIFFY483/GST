{
	"schemaVersion": 1,
	"id": "gst",
	"version": "${version}",
	"name": "Galactic Space Travel",
	"description": "Overworld ile uzay arasinda kesintisiz gecis saglayan ve procedural olarak uretilen galaksi olcekli bir uzay sistemi ekler.",
	"authors": [
		"Nihao"
	],
	"contact": {
	},
	"license": "CC0-1.0",
	"icon": "assets/gst/icon.png",
	"environment": "*",
